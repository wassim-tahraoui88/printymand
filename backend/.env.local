PORT=8080

# Short: 20 requests per 1 seconds and block for 10 seconds
THROTTLE_TTL_SHORT=1000
THROTTLE_LIMIT_SHORT=20
THROTTLE_BLOCK_DURATION_SHORT=10000

# Medium: 100 requests per 10 seconds and block for 1 minute
THROTTLE_TTL_MEDIUM=10000
THROTTLE_LIMIT_MEDIUM=100
THROTTLE_BLOCK_DURATION_MEDIUM=60000

# Long: 500 requests per 1 minute and block for 2 minutes
THROTTLE_TTL_LONG=60000
THROTTLE_LIMIT_LONG=500
THROTTLE_BLOCK_DURATION_LONG=120000

MONGODB_URL=
MONGODB_DB_NAME=
